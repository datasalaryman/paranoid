{
    "private": true,
    "name": "paranoid-standard-wallet",
    "version": "0.1.1",
    "author": "Jose Endrinal <datasalaryman@protonmail.com>",
    "repository": "https://github.com/datasalaryman/paranoid",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22"
    },
    "type": "module",
    "sideEffects": false,
    "main": "./lib/esm/index.js",
    "module": "./lib/esm/index.js",
    "types": "./lib/types/index.d.ts",
    "exports": {
        "import": "./lib/esm/index.js",
        "types": "./lib/types/index.d.ts"
    },
    "scripts": {
        "fmt": "prettier --write '{*,**/*}.{ts,tsx,js,jsx,json}'",
        "clean": "shx mkdir -p lib && shx rm -rf lib",
        "tsc": "tsc --project tsconfig.json",
        "build": "npm run clean && npm run tsc && npm run build:extension",
        "typecheck:extension": "tsc --project tsconfig.extension.json",
        "build:extension": "npm run typecheck:extension && shx rm -rf dist && shx mkdir -p dist && esbuild src/extension/background.ts src/extension/content.ts src/extension/inpage.ts src/extension/approval.ts src/extension/popup.ts --bundle --outdir=dist --platform=browser --target=chrome120 && shx cp src/extension/manifest.json src/extension/approval.html src/extension/popup.html src/extension/wallet.css dist"
    },
    "dependencies": {
        "@solana/wallet-standard-features": "^1.3.0",
        "@solana/web3.js": "^1.98.0",
        "@wallet-standard/base": "^1.1.0",
        "@wallet-standard/features": "^1.1.0",
        "bs58": "^6.0.0",
        "tweetnacl": "^1.0.3"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.326",
        "@types/node-fetch": "^2.6.12",
        "esbuild": "^0.25.8",
        "prettier": "^3.5.3",
        "shx": "^0.4.0",
        "typescript": "^5.8.3"
    }
}
