{
    "private": true,
    "name": "paranoid-standard-wallet",
    "version": "0.1.1",
    "author": "Jose Endrinal <datasalaryman@protonmail.com>",
    "repository": "https://github.com/datasalaryman/paranoid",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22"
    },
    "type": "module",
    "sideEffects": false,
    "main": "./lib/esm/lib/index.js",
    "module": "./lib/esm/lib/index.js",
    "types": "./lib/types/lib/index.d.ts",
    "exports": {
        "import": "./lib/esm/lib/index.js",
        "types": "./lib/types/lib/index.d.ts"
    },
    "scripts": {
        "fmt": "prettier --write '{*,**/*}.{ts,tsx,js,jsx,json}'",
        "clean": "shx mkdir -p lib && shx rm -rf lib dist .output",
        "tsc": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json --resolve-full-paths --resolve-full-extension .js",
        "build": "npm run clean && npm run tsc && npm run build:extension",
        "dev": "wxt",
        "prepare": "wxt prepare",
        "typecheck:extension": "wxt prepare && tsc --project tsconfig.extension.json",
        "build:extension": "npm run typecheck:extension && wxt build"
    },
    "dependencies": {
        "@scure/bip39": "^2.2.0",
        "@solana/wallet-standard-features": "^1.3.0",
        "@solana/web3.js": "^1.98.0",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-router": "^1.170.18",
        "@wallet-standard/base": "^1.1.0",
        "@wallet-standard/features": "^1.1.0",
        "bs58": "^6.0.0",
        "ed25519-hd-key": "^2.0.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tweetnacl": "^1.0.3"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/chrome": "^0.0.326",
        "@types/node-fetch": "^2.6.12",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@wxt-dev/module-react": "^1.2.2",
        "prettier": "^3.5.3",
        "shx": "^0.4.0",
        "tailwindcss": "^4.3.3",
        "tsc-alias": "^1.9.1",
        "typescript": "^5.8.3",
        "wxt": "^0.21.3"
    }
}
