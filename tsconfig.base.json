{
    "include": [],
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Node",
        "baseUrl": "src",
        "esModuleInterop": true,
        "isolatedModules": true,
        "noEmitOnError": true,
        "paths": {
            "@/lib/*": ["lib/*"],
            "@/*": ["*"]
        },
        "resolveJsonModule": true,
        "strict": true,
        "stripInternal": true,
        "noUncheckedIndexedAccess": true
    }
}
